{
  "system_overview": {
    "name": "AI Solution Platform",
    "description": "A cutting-edge full-stack web application showcasing AI-powered business solutions with modern design, comprehensive admin tools, and seamless deployment capabilities",
    "version": "0.1.0",
    "technology_stack": {
      "frontend": {
        "framework": "Next.js 15.4.4",
        "ui_library": "React 19.1.0",
        "language": "TypeScript 5.0",
        "styling": "Tailwind CSS 3.4",
        "animations": ["Framer Motion 12.23", "GSAP 3.13"],
        "3d_graphics": ["Three.js 0.180", "React Three Fiber 9.0", "Spline 4.1.0"],
        "particles": "TSParticles 3.9",
        "charts": "Recharts 3.2.1",
        "notifications": "React Hot Toast",
        "ui_components": "Lucide React Icons"
      },
      "backend": {
        "database": "Neon Database (PostgreSQL)",
        "orm": "Drizzle ORM 0.44",
        "email_service": "Resend",
        "validation": "Zod 4.0",
        "authentication": "JWT",
        "password_hashing": "bcrypt"
      },
      "deployment": {
        "platform": "Vercel",
        "analytics": "Vercel Analytics",
        "monitoring": "Built-in performance monitoring"
      }
    }
  },
  "modules": {
    "user_facing": [
      {
        "name": "Home Page",
        "route": "/",
        "description": "AI solutions showcase with 3D elements and interactive demos",
        "features": ["3D animations", "Interactive showcases", "Call-to-action sections", "Performance metrics"]
      },
      {
        "name": "Solutions Page",
        "route": "/solutions",
        "description": "Detailed AI service offerings with categories and features",
        "features": ["Solution categories", "Feature comparisons", "Pricing information", "Demo booking"]
      },
      {
        "name": "Blog",
        "route": "/blog",
        "description": "Public blog with articles and content management",
        "features": ["Article listings", "Markdown support", "Category filtering", "Search functionality"]
      },
      {
        "name": "Events",
        "route": "/events",
        "description": "Event listings and detailed event information",
        "features": ["Event calendar", "RSVP functionality", "Event details", "Location information"]
      },
      {
        "name": "Contact",
        "route": "/contact",
        "description": "Contact form with inquiry submission and 3D elements",
        "features": ["Multi-field form", "Validation", "3D background", "Success/error states"]
      },
      {
        "name": "Testimonials",
        "route": "/testimonials",
        "description": "Customer reviews and feedback display",
        "features": ["Rating display", "Customer testimonials", "Filtering options", "Admin moderation"]
      },
      {
        "name": "Book Demo",
        "route": "/book-demo",
        "description": "Interactive demo booking system for AI solutions",
        "features": ["Solution selection", "Scheduling", "Form validation", "Email confirmations"]
      }
    ],
    "admin_facing": [
      {
        "name": "Admin Dashboard",
        "route": "/admin/dashboard",
        "description": "Main admin dashboard with analytics and overview",
        "features": ["Real-time metrics", "Charts and graphs", "Quick actions", "Recent activity"]
      },
      {
        "name": "Analytics",
        "route": "/admin/analytics",
        "description": "Detailed analytics with charts and insights",
        "features": ["Country-based analytics", "Reason-based analytics", "Source tracking", "Time-series data"]
      },
      {
        "name": "Inquiry Management",
        "route": "/admin/inquiries",
        "description": "Manage customer inquiries with filtering and responses",
        "features": ["Inquiry listing", "Status management", "Admin responses", "Filtering and search"]
      },
      {
        "name": "Blog Management",
        "route": "/admin/blog",
        "description": "Create and manage blog posts with rich text editing",
        "features": ["CRUD operations", "Rich text editor", "Image uploads", "Publishing workflow"]
      },
      {
        "name": "Event Management",
        "route": "/admin/events",
        "description": "Event creation and management system",
        "features": ["Event CRUD", "RSVP tracking", "Status management", "Banner uploads"]
      },
      {
        "name": "Demo Booking Management",
        "route": "/admin/bookings",
        "description": "Manage AI solution demonstration bookings",
        "features": ["Booking listing", "Scheduling", "Status updates", "Admin notes"]
      },
      {
        "name": "AI Solutions Management",
        "route": "/admin/solutions",
        "description": "Create and manage AI service offerings",
        "features": ["Solution CRUD", "Feature management", "Pricing setup", "Category organization"]
      },
      {
        "name": "Rating & Testimonial Management",
        "route": "/admin/ratings",
        "description": "Handle customer ratings and reviews",
        "features": ["Rating moderation", "Testimonial creation", "Status management", "Admin replies"]
      },
      {
        "name": "Settings",
        "route": "/admin/settings",
        "description": "System configuration and user management",
        "features": ["Password change", "Activity logs", "User preferences", "System diagnostics", "Enhanced backup management", "Deleted data recovery"]
      }
    ],
    "system_services": [
      {
        "name": "Authentication & Authorization",
        "description": "JWT-based authentication with session management",
        "features": ["Admin login", "Session validation", "Route protection", "Password hashing"]
      },
      {
        "name": "Email Service",
        "description": "Resend integration for email delivery",
        "features": ["Inquiry confirmations", "Admin notifications", "Demo confirmations", "Status tracking"]
      },
      {
        "name": "Database Operations",
        "description": "PostgreSQL database with Drizzle ORM",
        "features": ["CRUD operations", "Query optimization", "Migrations", "Connection pooling"]
      },
      {
        "name": "Rate Limiting & Validation",
        "description": "API protection and input validation",
        "features": ["Rate limiting", "Input sanitization", "XSS protection", "CSRF protection"]
      },
      {
        "name": "Activity Logging",
        "description": "Comprehensive activity tracking system",
        "features": ["Admin actions", "User interactions", "System events", "Audit trails"]
      },
      {
        "name": "Analytics Data Processing",
        "description": "Real-time analytics and reporting",
        "features": ["Data aggregation", "Chart generation", "Export functionality", "Performance metrics"]
      },
      {
        "name": "File Upload & Media Management",
        "description": "Image and media handling",
        "features": ["Image optimization", "WebP/AVIF support", "File validation", "Storage management"]
      },
      {
        "name": "Data Export",
        "description": "Export functionality for analytics and user data",
        "features": ["CSV export", "PDF reports", "Data filtering", "Bulk operations"]
      },
      {
        "name": "Enhanced Backup & Recovery",
        "description": "Comprehensive backup and data recovery system",
        "features": ["Table-specific backups", "Deleted data tracking", "CSV export", "Dual storage", "Dynamic date ranges", "3-month retention", "Recovery operations", "Permanent deletion"]
      }
    ]
  },
  "data_stores": [
    {
      "name": "Inquiries",
      "table": "inquiries",
      "description": "Contact form submissions and customer inquiries",
      "primary_key": "id (uuid)",
      "fields": [
        "id", "name", "email", "phone", "company", "country", "occupation",
        "reason", "howDidYouHear", "messageTitle", "message", "adminResponse",
        "respondedAt", "status", "tags", "source", "createdAt"
      ],
      "relationships": [
        "ActivityLogs (one-to-many) - inquiries.id -> activity_logs.targetId"
      ]
    },
    {
      "name": "Demo Bookings",
      "table": "demo_bookings",
      "description": "AI solution demonstration booking requests",
      "primary_key": "id (uuid)",
      "fields": [
        "id", "name", "email", "company", "solutionId", "solutionName",
        "message", "preferredDate", "preferredTime", "status", "adminNotes",
        "adminReply", "repliedAt", "scheduledAt", "createdAt", "updatedAt"
      ],
      "relationships": [
        "Solutions (many-to-one) - demo_bookings.solutionId -> solutions.id",
        "ActivityLogs (one-to-many) - demo_bookings.id -> activity_logs.targetId"
      ]
    },
    {
      "name": "Solutions",
      "table": "solutions",
      "description": "AI solution offerings and services",
      "primary_key": "id (uuid)",
      "fields": [
        "id", "title", "description", "shortDescription", "category", "features",
        "benefits", "useCases", "pricing", "imageUrl", "iconName", "status",
        "featured", "sortOrder", "createdAt", "updatedAt"
      ],
      "relationships": [
        "DemoBookings (one-to-many) - solutions.id -> demo_bookings.solutionId"
      ]
    },
    {
      "name": "Blogs",
      "table": "blogs",
      "description": "Blog posts and articles",
      "primary_key": "id (uuid)",
      "fields": [
        "id", "title", "content", "excerpt", "author", "image", "category",
        "tags", "readTime", "status", "publishedAt", "createdAt", "updatedAt"
      ],
      "relationships": []
    },
    {
      "name": "Events",
      "table": "events",
      "description": "Events and conferences",
      "primary_key": "id (uuid)",
      "fields": [
        "id", "title", "description", "date", "time", "location", "category",
        "bannerUrl", "status", "createdAt", "updatedAt"
      ],
      "relationships": [
        "EventRsvps (one-to-many) - events.id -> event_rsvps.eventId"
      ]
    },
    {
      "name": "Event RSVPs",
      "table": "event_rsvps",
      "description": "Event RSVP registrations",
      "primary_key": "id (uuid)",
      "fields": [
        "id", "eventId", "name", "email", "company", "attendees", "createdAt"
      ],
      "relationships": [
        "Events (many-to-one) - event_rsvps.eventId -> events.id"
      ]
    },
    {
      "name": "Ratings",
      "table": "ratings",
      "description": "Customer ratings and feedback",
      "primary_key": "id (uuid)",
      "fields": [
        "id", "name", "email", "rating", "comment", "isPublished", "adminReply",
        "repliedAt", "status", "createdAt", "updatedAt"
      ],
      "relationships": [
        "Testimonials (one-to-one) - ratings.id -> testimonials.ratingId"
      ]
    },
    {
      "name": "Testimonials",
      "table": "testimonials",
      "description": "Published customer testimonials",
      "primary_key": "id (uuid)",
      "fields": [
        "id", "ratingId", "name", "role", "company", "testimonial", "rating",
        "status", "createdAt", "updatedAt"
      ],
      "relationships": [
        "Ratings (one-to-one) - testimonials.ratingId -> ratings.id"
      ]
    },
    {
      "name": "Admin Users",
      "table": "admin_users",
      "description": "Admin user authentication and authorization",
      "primary_key": "id (uuid)",
      "fields": ["id", "email", "passwordHash", "role", "createdAt"],
      "relationships": [
        "ActivityLogs (one-to-many) - admin_users.id -> activity_logs.adminId"
      ]
    },
    {
      "name": "Activity Logs",
      "table": "activity_logs",
      "description": "System activity tracking and audit logs",
      "primary_key": "id (uuid)",
      "fields": [
        "id", "adminId", "action", "description", "targetType", "targetId",
        "metadata", "ipAddress", "userAgent", "createdAt"
      ],
      "relationships": [
        "AdminUsers (many-to-one) - activity_logs.adminId -> admin_users.id",
        "Inquiries (many-to-one) - activity_logs.targetId -> inquiries.id (when targetType='inquiry')",
        "DemoBookings (many-to-one) - activity_logs.targetId -> demo_bookings.id (when targetType='booking')"
      ]
    },
    {
      "name": "Backup Metadata",
      "table": "backup_metadata",
      "description": "Backup creation metadata and configuration",
      "primary_key": "id (uuid)",
      "fields": [
        "id", "name", "description", "tables", "createdBy", "dateFrom", 
        "dateTo", "recoveryPoint", "createdAt"
      ],
      "relationships": [
        "AdminUsers (many-to-one) - backup_metadata.createdBy -> admin_users.id",
        "BackupData (one-to-many) - backup_metadata.id -> backup_data.backupId"
      ]
    },
    {
      "name": "Backup Data",
      "table": "backup_data",
      "description": "Actual backup data storage",
      "primary_key": "id (uuid)",
      "fields": [
        "id", "backupId", "tableName", "recordData", "isDeleted", "createdAt"
      ],
      "relationships": [
        "BackupMetadata (many-to-one) - backup_data.backupId -> backup_metadata.id"
      ]
    },
    {
      "name": "Deleted Records",
      "table": "deleted_records",
      "description": "Tracked deleted records for recovery",
      "primary_key": "id (uuid)",
      "fields": [
        "id", "tableName", "recordId", "deletedData", "deletedAt", 
        "deletedBy", "reason", "originalCreatedAt", "originalUpdatedAt", "recovered"
      ],
      "relationships": [
        "AdminUsers (many-to-one) - deleted_records.deletedBy -> admin_users.id"
      ]
    },
    {
      "name": "Table Metadata",
      "table": "table_metadata",
      "description": "Metadata about table data ranges and statistics",
      "primary_key": "tableName",
      "fields": [
        "tableName", "firstRecordDate", "lastRecordDate", "totalRecords", "lastUpdated"
      ],
      "relationships": []
    }
  ],
