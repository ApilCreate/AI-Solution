  "database_schema": {
    "tables": [
      {
        "name": "inquiries",
        "description": "Contact form submissions",
        "primary_key": "id (uuid)",
        "indexes": ["email", "status", "createdAt"],
        "constraints": ["NOT NULL on required fields", "UNIQUE on id"]
      },
      {
        "name": "admin_users",
        "description": "Admin user accounts",
        "primary_key": "id (uuid)",
        "indexes": ["email"],
        "constraints": ["UNIQUE on email", "NOT NULL on required fields"]
      },
      {
        "name": "demo_bookings",
        "description": "AI solution demo bookings",
        "primary_key": "id (uuid)",
        "foreign_keys": ["solutionId -> solutions.id"],
        "indexes": ["solutionId", "status", "createdAt"]
      },
      {
        "name": "blogs",
        "description": "Blog posts and articles",
        "primary_key": "id (uuid)",
        "indexes": ["status", "publishedAt", "category"],
        "constraints": ["NOT NULL on required fields"]
      },
      {
        "name": "events",
        "description": "Events and conferences",
        "primary_key": "id (uuid)",
        "indexes": ["date", "status", "category"],
        "constraints": ["NOT NULL on required fields"]
      },
      {
        "name": "solutions",
        "description": "AI solution offerings",
        "primary_key": "id (uuid)",
        "indexes": ["category", "status", "featured"],
        "constraints": ["NOT NULL on required fields"]
      },
      {
        "name": "ratings",
        "description": "Customer ratings and feedback",
        "primary_key": "id (uuid)",
        "indexes": ["status", "isPublished", "createdAt"],
        "constraints": ["CHECK rating BETWEEN 1 AND 5"]
      },
      {
        "name": "testimonials",
        "description": "Published customer testimonials",
        "primary_key": "id (uuid)",
        "foreign_keys": ["ratingId -> ratings.id"],
        "indexes": ["status", "createdAt"]
      },
      {
        "name": "event_rsvps",
        "description": "Event RSVP registrations",
        "primary_key": "id (uuid)",
        "foreign_keys": ["eventId -> events.id"],
        "indexes": ["eventId", "createdAt"]
      },
      {
        "name": "activity_logs",
        "description": "System activity audit logs",
        "primary_key": "id (uuid)",
        "foreign_keys": ["adminId -> admin_users.id"],
        "indexes": ["adminId", "action", "createdAt", "targetType"]
      },
      {
        "name": "backup_metadata",
        "description": "Backup creation metadata and configuration",
        "primary_key": "id (uuid)",
        "foreign_keys": ["createdBy -> admin_users.id"],
        "indexes": ["createdBy", "createdAt", "tables"]
      },
      {
        "name": "backup_data",
        "description": "Actual backup data storage",
        "primary_key": "id (uuid)",
        "foreign_keys": ["backupId -> backup_metadata.id"],
        "indexes": ["backupId", "tableName", "createdAt"]
      },
      {
        "name": "deleted_records",
        "description": "Tracked deleted records for recovery",
        "primary_key": "id (uuid)",
        "foreign_keys": ["deletedBy -> admin_users.id"],
        "indexes": ["tableName", "deletedAt", "recovered", "deletedBy"]
      },
      {
        "name": "table_metadata",
        "description": "Metadata about table data ranges and statistics",
        "primary_key": "tableName",
        "foreign_keys": [],
        "indexes": ["lastUpdated", "totalRecords"]
      }
    ]
  },
  "file_structure": {
    "app": {
      "description": "Next.js App Router structure",
      "subdirectories": [
        "admin/ - Admin dashboard pages",
        "api/ - API route handlers (including backup management)",
        "blog/ - Public blog pages",
        "contact/ - Contact form page",
        "events/ - Public events pages",
        "solutions/ - AI solutions showcase",
        "testimonials/ - Customer testimonials",
        "contexts/ - React context providers",
