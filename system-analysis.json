  "actors": [
    {
      "name": "Visitor",
      "type": "External Entity",
      "description": "Website visitors who browse content, submit inquiries, and book demos",
      "interactions": [
        "Browse AI solutions showcase",
        "Submit contact inquiries",
        "Book AI solution demos",
        "View blog posts and events",
        "Submit ratings and feedback"
      ]
    },
    {
      "name": "Admin",
      "type": "External Entity", 
      "description": "System administrators who manage content, respond to inquiries, and monitor analytics",
      "interactions": [
        "Authenticate and access admin dashboard",
        "Manage inquiries and demo bookings with delete functionality",
        "Create and edit content (blogs, events, solutions)",
        "Monitor analytics and system health",
        "Respond to customer communications",
        "Create and manage data backups",
        "Recover accidentally deleted records",
        "Export data in CSV format",
        "Configure backup retention policies",
        "Monitor deleted data and perform cleanup operations"
      ]
    },
    {
      "name": "Email Service (Resend)",
      "type": "External Entity",
      "description": "Third-party email delivery service for sending notifications and confirmations",
      "interactions": [
        "Send inquiry confirmation emails",
        "Send demo booking confirmations",
        "Send admin notifications",
        "Provide email delivery status"
      ]
    },
    {
      "name": "Database (Neon PostgreSQL)",
      "type": "External Entity",
      "description": "Cloud database service for data persistence",
      "interactions": [
        "Store and retrieve inquiry data",
        "Manage user authentication data",
        "Handle content management operations",
        "Process analytics queries"
      ]
    }
  ],
  "core_flows": [
    {
      "name": "Inquiry Submission Flow",
      "description": "Visitor submits inquiry through contact form",
      "level": "Level 1",
      "steps": [
        "Visitor fills contact form",
        "Client-side validation",
        "Rate limiting check",
        "Server-side validation",
        "Database insertion",
        "Email confirmation to visitor",
        "Admin notification",
        "Activity logging"
      ],
      "sub_flows": [
        {
          "name": "Inquiry Validation & Processing",
          "level": "Level 2",
          "description": "Detailed validation and processing of inquiry submissions",
          "steps": [
            "Form data collection",
            "Client-side validation (required fields, email format)",
            "Rate limiting check (IP-based)",
            "Server-side validation with Zod schemas",
            "Input sanitization (XSS protection)",
            "Database insertion with retry logic",
            "Email service integration",
            "Activity log creation",
            "Response to client"
          ]
        }
      ]
    },
    {
      "name": "Demo Booking Flow",
      "description": "Visitor books AI solution demonstration",
      "level": "Level 1",
      "steps": [
        "Visitor selects solution",
        "Fills booking form",
        "Validation and rate limiting",
        "Database insertion",
        "Email confirmation",
        "Admin scheduling",
        "Status updates",
        "Activity logging"
      ],
      "sub_flows": [
        {
          "name": "Demo Booking Processing",
          "level": "Level 2",
          "description": "Detailed processing of demo booking requests",
          "steps": [
            "Solution selection and validation",
            "Booking form data collection",
            "Availability checking",
            "Rate limiting verification",
            "Solution ID validation",
            "Database insertion with foreign key constraints",
            "Email confirmation generation",
            "Admin notification dispatch",
            "Activity logging with metadata",
            "Status tracking initialization"
          ]
        }
      ]
    },
    {
      "name": "Admin Content Management Flow",
      "description": "Admin creates and manages content",
      "level": "Level 1",
      "steps": [
        "Admin authentication",
        "Content creation/editing",
        "Validation and sanitization",
        "Database operations",
        "Status management",
        "Activity logging",
        "Public page updates"
      ]
    },
    {
      "name": "Admin Authentication Flow",
      "description": "Admin login and session management",
      "level": "Level 1",
      "steps": [
        "Admin enters credentials",
        "Server validation",
        "Password verification",
        "JWT token generation",
        "Session establishment",
        "Dashboard access",
        "Activity logging"
      ]
    },
    {
      "name": "Analytics Processing Flow",
      "description": "Real-time analytics and reporting",
      "level": "Level 1",
      "steps": [
        "Data collection",
        "Aggregation processing",
        "Chart generation",
        "Dashboard updates",
        "Export functionality",
        "Performance monitoring"
      ]
    },
    {
      "name": "Backup & Recovery Flow",
      "description": "Data backup creation and recovery operations",
      "level": "Level 1",
      "steps": [
        "Admin initiates backup creation",
        "Dynamic date range detection",
        "Table data extraction",
        "CSV generation and storage",
        "Database backup storage",
        "Metadata recording",
        "Recovery operations",
        "Data validation and restoration"
      ],
      "sub_flows": [
        {
          "name": "Backup Creation Process",
          "level": "Level 2",
          "description": "Detailed backup creation and storage process",
          "steps": [
            "Admin selects tables and date range",
            "Dynamic date range calculation",
            "Data extraction from selected tables",
            "CSV file generation",
            "Database backup record creation",
            "File system storage",
            "Metadata logging",
            "Activity logging"
          ]
        },
        {
          "name": "Data Recovery Process",
          "level": "Level 2",
          "description": "Recovery of deleted or backed up data",
          "steps": [
            "Admin selects records for recovery",
            "Data validation and integrity checks",
            "Record insertion with conflict resolution",
            "Activity logging",
            "Status updates",
            "Notification dispatch"
          ]
        }
      ]
    }
  ],
  "security_features": [
    {
      "category": "Authentication & Authorization",
      "features": [
        "JWT token-based authentication",
        "HttpOnly cookies for session management",
        "Route protection with AdminGuard",
        "bcrypt password hashing",
        "Session validation middleware"
      ]
    },
    {
      "category": "Input Validation & Sanitization",
      "features": [
        "Zod schema validation",
